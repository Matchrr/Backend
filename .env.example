APP_NAME=Matchr Backend
APP_ENV=development
API_PREFIX=/api
PORT=4000
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Supabase (PostgreSQL + pgvector)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Xano user authentication (JWT). Same instance URL as the job catalog is fine.
# Auth endpoints must exist on this API group: /auth/signup, /auth/login, /auth/me,
# /reset/request-reset-link, /reset/magic-link-login, /reset/update_password.
# FRONTEND_URL is the origin baked into password-reset emails.
# Leave XANO_AUTH_API_URL empty to use XANO_API_URL. Set XANO_AUTH_REQUIRED=true
# to force the login gate before those endpoints exist (requests will 401).
# Google sign-in also needs POST /auth/google on that group and a Xano env var
# matchr_service_secret equal to MATCHR_SERVICE_SECRET.
XANO_API_URL=
XANO_AUTH_API_URL=
XANO_AUTH_REQUIRED=
# Service key for Matchr table CRUD (profiles, source documents). Not the user JWT.
XANO_API_KEY=

# Downstream services
AI_SERVICE_URL=http://localhost:8080
MATCHR_SERVICE_SECRET=matchr-dev

# Integrations
SERPAPI_API_KEY=
NUTRIENT_API_KEY=
KONG_GATEWAY_URL=
NAMECOM_API_KEY=
NAMECOM_USERNAME=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:4000/api/integrations/linkedin/callback
# Optional. Only set this if the LinkedIn app has Member Data Portability.
# Example: r_dma_portability_3rd_party
LINKEDIN_DMA_SCOPE=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Sign in with Google. Create a Web application OAuth client in Google Cloud.
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback


AWS_REGION=ca-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MATCHR_S3_BUCKET=matchr-dev